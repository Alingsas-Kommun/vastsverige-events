{
  "name": "alingsas-kommun/vastsverige-events",
  "description": "Imports Västsverige events into Event Manager posts.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "VastsverigeEvents\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VastsverigeEvents\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testdox"
  }
}
